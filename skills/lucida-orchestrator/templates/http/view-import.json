{
  "operation_id": "view.import",
  "method": "POST",
  "path": "/import/viewstate",
  "request": {
    "schema_version": 1,
    "session_id": "<session_id>",
    "view_state": {
      "schema_version": 1,
      "view_id": "<source_view_id>",
      "session_id": "<source_session_id>",
      "mode": "2d",
      "datasets": [
        {
          "dataset_id": "<dataset_id>",
          "multiscale_name": "primary"
        }
      ],
      "viewport": {
        "width_px": 256,
        "height_px": 192,
        "pixel_ratio": 1.0
      },
      "selectors": [
        {
          "axis": "z",
          "kind": "index",
          "index": 0,
          "clamp": true
        }
      ],
      "view_2d": {
        "plane": "xy",
        "slice": {
          "axis": "z",
          "index": 0,
          "slab": {
            "thickness_vox": 1,
            "mode": "single"
          }
        },
        "camera": {
          "center_world": [
            0.0,
            0.0
          ],
          "zoom": 1.0,
          "rotation_deg": 0.0
        }
      },
      "layers": [
        {
          "layer_id": "image_0",
          "type": "image",
          "dataset_id": "<dataset_id>",
          "source": {
            "multiscale_name": "primary"
          },
          "visible": true,
          "opacity": 1.0,
          "image": {
            "channel_mode": "single",
            "channels": [
              {
                "index": 0,
                "enabled": true
              }
            ]
          }
        }
      ]
    }
  },
  "notes": [
    "Prefer using view.export output as the source view_state for import workflows."
  ],
  "required_inputs": [
    "view_state"
  ],
  "expected_output_fields": [
    "import_id",
    "view_state.view_id",
    "view_state.state_hash"
  ],
  "common_failure_codes": [
    "invalid_request",
    "dataset_not_found",
    "unsupported_mode"
  ]
}
