{
  "operation_id": "view.pan",
  "method": "POST",
  "path": "/view/update",
  "request": {
    "schema_version": 1,
    "view_id": "<view_id>",
    "session_id": "<session_id>",
    "patch": [
      {
        "op": "replace",
        "path": "/view_2d/camera/center_world",
        "value": [
          64.0,
          64.0
        ]
      }
    ]
  },
  "notes": [
    "Derive the new center from current zoom and pixel_ratio to mirror CLI helper behavior."
  ],
  "required_inputs": [
    "view_id",
    "dx_px",
    "dy_px"
  ],
  "expected_output_fields": [
    "view_state.view_2d.camera.center_world",
    "view_state.state_hash"
  ],
  "common_failure_codes": [
    "view_not_found",
    "invalid_patch"
  ]
}
