# CHANGELOG.md is append-only (release tooling adds entries at the end).
# A union merge keeps the appended lines from both sides instead of conflicting,
# so stacked branches / concurrent entries merge cleanly.
CHANGELOG.md merge=union

# Wire-protocol golden fixtures are byte-compared by lucida-server's
# wire_goldens test; normalize line endings so a CRLF checkout cannot
# break the byte-for-byte lock.
wire-fixtures/**/*.json text eol=lf

# The view-property fixtures are compared byte for byte by lucida-core.
fixtures/view-properties/*.json text eol=lf
