{
  "description": "large-canvas-orbit after 12 s with nothing to draw, long enough for a desktop GPU to drop to its idle clocks, so the orbit starts on them",
  "requires": ["volume"],
  "camera": "arcball",
  "width": 1674,
  "height": 921,
  "steps": [
    { "kind": "zoom", "factor": 4, "durationMs": 1000 },
    { "kind": "wait" },
    { "kind": "hold", "ms": 12000 },
    { "kind": "orbit", "theta": 60, "phi": 20, "durationMs": 2000 },
    { "kind": "pan", "dx": -400, "dy": -100, "durationMs": 1500 }
  ]
}
