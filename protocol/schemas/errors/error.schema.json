{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucida.dev/schemas/errors/error.schema.json",
  "title": "Lucida Error Envelope",
  "type": "object",
  "$defs": {
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "../common/primitives.schema.json#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "code",
        "message",
        "details",
        "retryable"
      ]
    }
  }
}
