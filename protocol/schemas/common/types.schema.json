{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucida.dev/schemas/common/types.schema.json",
  "title": "Lucida Composite Types",
  "type": "object",
  "$defs": {
    "CapabilityFlags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "async_jobs": {
          "type": "boolean"
        },
        "dedicated_event_stream": {
          "type": "boolean"
        },
        "idempotency_keys": {
          "type": "boolean"
        },
        "dataref_oob": {
          "type": "boolean"
        },
        "total_ordered_events": {
          "type": "boolean"
        },
        "command_log_replay": {
          "type": "boolean"
        }
      },
      "required": [
        "async_jobs",
        "dedicated_event_stream",
        "idempotency_keys",
        "dataref_oob",
        "total_ordered_events",
        "command_log_replay"
      ]
    },
    "RequestMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "$ref": "primitives.schema.json#/$defs/SemVer"
        },
        "request_id": {
          "$ref": "primitives.schema.json#/$defs/UUIDv7"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{8,128}$"
        }
      },
      "required": [
        "protocol_version",
        "request_id"
      ]
    },
    "MutatingRequestMeta": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestMeta"
        },
        {
          "type": "object",
          "required": [
            "idempotency_key"
          ]
        }
      ]
    },
    "EventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "$ref": "primitives.schema.json#/$defs/SemVer"
        },
        "session_id": {
          "$ref": "primitives.schema.json#/$defs/UUIDv7"
        },
        "event_id": {
          "$ref": "primitives.schema.json#/$defs/UUIDv7"
        },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{2,63}$"
        },
        "session_seq": {
          "$ref": "primitives.schema.json#/$defs/SessionSeq"
        },
        "emitted_at": {
          "$ref": "primitives.schema.json#/$defs/Timestamp"
        }
      },
      "required": [
        "protocol_version",
        "session_id",
        "event_id",
        "event_type",
        "session_seq",
        "emitted_at"
      ]
    },
    "AsyncAccepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "$ref": "primitives.schema.json#/$defs/UUIDv7"
        },
        "accepted_at": {
          "$ref": "primitives.schema.json#/$defs/Timestamp"
        },
        "state": {
          "type": "string",
          "const": "queued"
        }
      },
      "required": [
        "job_id",
        "accepted_at",
        "state"
      ]
    },
    "Transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 1
        },
        "translate": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        }
      },
      "required": [
        "scale",
        "translate"
      ]
    },
    "CameraPose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "up": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "fov_degrees": {
          "type": "number",
          "minimum": 1,
          "maximum": 179
        }
      },
      "required": [
        "position",
        "target",
        "up"
      ]
    },
    "AxisIndex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "axis": {
          "$ref": "primitives.schema.json#/$defs/AxisLabel"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "axis",
        "index"
      ]
    },
    "DataRefSharedMemory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "shared_memory"
        },
        "shm_name": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "strides": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "endianness": {
          "$ref": "primitives.schema.json#/$defs/Endianness"
        },
        "compression": {
          "$ref": "primitives.schema.json#/$defs/Compression"
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1
        },
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "shm_name",
        "dtype",
        "shape",
        "endianness",
        "compression",
        "ttl_ms",
        "checksum_sha256"
      ]
    },
    "DataRefTempFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "temp_file"
        },
        "file_path": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "strides": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "endianness": {
          "$ref": "primitives.schema.json#/$defs/Endianness"
        },
        "compression": {
          "$ref": "primitives.schema.json#/$defs/Compression"
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1
        },
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "file_path",
        "dtype",
        "shape",
        "endianness",
        "compression",
        "ttl_ms",
        "checksum_sha256"
      ]
    },
    "DataRefUri": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "uri"
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "strides": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "endianness": {
          "$ref": "primitives.schema.json#/$defs/Endianness"
        },
        "compression": {
          "$ref": "primitives.schema.json#/$defs/Compression"
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1
        },
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "uri",
        "dtype",
        "shape",
        "endianness",
        "compression",
        "ttl_ms",
        "checksum_sha256"
      ]
    },
    "DataRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/DataRefSharedMemory"
        },
        {
          "$ref": "#/$defs/DataRefTempFile"
        },
        {
          "$ref": "#/$defs/DataRefUri"
        }
      ]
    },
    "PointsFilterEq": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "eq"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean"
          ]
        }
      },
      "required": [
        "op",
        "field",
        "value"
      ]
    },
    "PointsFilterExists": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "exists"
        },
        "field": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "op",
        "field"
      ]
    },
    "PointsFilterRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "range"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "include_min": {
          "type": "boolean"
        },
        "include_max": {
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "field"
      ]
    },
    "PointsFilterIn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "in"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "op",
        "field",
        "values"
      ]
    },
    "PointsFilterNot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "not"
        },
        "predicate": {
          "$ref": "#/$defs/PointsFilterPredicate"
        }
      },
      "required": [
        "op",
        "predicate"
      ]
    },
    "PointsFilterAnd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "and"
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PointsFilterPredicate"
          },
          "minItems": 1
        }
      },
      "required": [
        "op",
        "predicates"
      ]
    },
    "PointsFilterOr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "or"
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PointsFilterPredicate"
          },
          "minItems": 1
        }
      },
      "required": [
        "op",
        "predicates"
      ]
    },
    "PointsFilterPredicate": {
      "oneOf": [
        {
          "$ref": "#/$defs/PointsFilterEq"
        },
        {
          "$ref": "#/$defs/PointsFilterExists"
        },
        {
          "$ref": "#/$defs/PointsFilterRange"
        },
        {
          "$ref": "#/$defs/PointsFilterIn"
        },
        {
          "$ref": "#/$defs/PointsFilterNot"
        },
        {
          "$ref": "#/$defs/PointsFilterAnd"
        },
        {
          "$ref": "#/$defs/PointsFilterOr"
        }
      ]
    },
    "PointsSelectionQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "box",
            "lasso",
            "predicate",
            "ids"
          ]
        },
        "combine": {
          "type": "string",
          "enum": [
            "replace",
            "union",
            "intersect",
            "subtract"
          ]
        },
        "predicate": {
          "$ref": "#/$defs/PointsFilterPredicate"
        },
        "box_world": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 3
            },
            "max": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 3
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "lasso_world": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 3
          },
          "minItems": 3
        },
        "ids": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            {
              "$ref": "#/$defs/DataRef"
            }
          ]
        }
      },
      "required": [
        "mode",
        "combine"
      ]
    },
    "PointsSelectionResolved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "selected_point_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 4096
        },
        "selected_point_ids_ref": {
          "$ref": "#/$defs/DataRef"
        }
      },
      "required": [
        "count"
      ]
    },
    "LinkedImageContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "centroid_world": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 3
        },
        "bbox_world": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 3
            },
            "max": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 3
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "slice_hint": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "centroid_world",
        "bbox_world",
        "slice_hint"
      ]
    },
    "PointsSelectionState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selection_version": {
          "type": "integer",
          "minimum": 1
        },
        "query": {
          "$ref": "#/$defs/PointsSelectionQuery"
        },
        "resolved": {
          "$ref": "#/$defs/PointsSelectionResolved"
        },
        "created_at": {
          "$ref": "primitives.schema.json#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "primitives.schema.json#/$defs/Timestamp"
        }
      },
      "required": [
        "selection_version",
        "query",
        "resolved",
        "updated_at"
      ]
    },
    "LegacySelectionObject": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "indices"
      ]
    },
    "PointsLayerStateSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "point_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "attribute_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "active_lod": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lod_cell_px": {
              "type": "integer",
              "minimum": 1
            },
            "lod_max_points": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "lod_cell_px",
            "lod_max_points"
          ]
        },
        "active_filter": {
          "$ref": "#/$defs/PointsFilterPredicate"
        }
      },
      "required": [
        "point_count",
        "edge_count",
        "attribute_columns",
        "active_lod"
      ]
    }
  }
}
