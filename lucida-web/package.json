{
  "name": "lucida-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=9.15.9 <10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:wasm": "cd ../lucida-core && wasm-pack build --target web --out-dir pkg -- --locked",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser-contracts": "node scripts/headless-browser-contract.test.mjs && node scripts/gpu-resource-stress.mjs",
    "test:gpu-browser": "node scripts/gpu-resource-stress.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "lucida-core": "link:../lucida-core/pkg",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@webgpu/types": "^0.1.69",
    "axe-core": "4.12.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.9.0",
    "playwright": "1.61.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.2.0",
      "@babel/core": "^7.29.6",
      "esbuild": "^0.28.1"
    }
  }
}
