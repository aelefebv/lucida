{
  "name": "lucida-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:wasm": "cd ../lucida-core && wasm-pack build --target web --out-dir pkg",
