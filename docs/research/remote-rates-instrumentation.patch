diff --git a/lucida-store/src/rrtrace.rs b/lucida-store/src/rrtrace.rs
new file mode 100644
index 0000000..c2fddc5
--- /dev/null
+++ b/lucida-store/src/rrtrace.rs
@@ -0,0 +1,92 @@
+//! THROWAWAY MEASUREMENT INSTRUMENTATION — issue #899 (research/remote-rates).
+//!
+//! Emits one compact stderr line per source read so a harness can rebuild the
+//! latency distribution of a remote object-store open. Off unless
+//! `LUCIDA_RR_TRACE=1`, and reverted before the research branch is committed;
+//! the diff lives in `docs/research/remote-rates-instrumentation.patch`.
+//!
+//! Line formats (whitespace separated, all times in microseconds):
+//!
+//! ```text
+//! RRGET  <epoch_us> <hit|miss|coalesce|orphan> <total_us> <bytes>
+//! RRBAK  <epoch_us> <permit_us> <ttfb_us> <body_us> <bytes> <inflight_at_start> <ok|err>
+//! RRSRV  <epoch_us> <store_us> <decode_us> <total_us> <bytes>
+//! ```
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicI64, Ordering};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+pub static BACKEND_INFLIGHT: AtomicI64 = AtomicI64::new(0);
+
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("LUCIDA_RR_TRACE").as_deref() == Ok("1"))
+}
+
+pub fn now_us() -> u128 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_micros()
+}
+
+pub fn emit_get(outcome: &str, total_us: u128, bytes: usize) {
+    if !enabled() {
+        return;
+    }
+    eprintln!("RRGET {} {} {} {}", now_us(), outcome, total_us, bytes);
+}
+
+pub fn emit_backend(
+    permit_us: u128,
+    ttfb_us: u128,
+    body_us: u128,
+    bytes: usize,
+    inflight: i64,
+    ok: bool,
+) {
+    if !enabled() {
+        return;
+    }
+    eprintln!(
+        "RRBAK {} {} {} {} {} {} {}",
+        now_us(),
+        permit_us,
+        ttfb_us,
+        body_us,
+        bytes,
+        inflight,
+        if ok { "ok" } else { "err" }
+    );
+}
+
+pub fn emit_serve(store_us: u128, decode_us: u128, total_us: u128, bytes: usize) {
+    if !enabled() {
+        return;
+    }
+    eprintln!(
+        "RRSRV {} {} {} {} {}",
+        now_us(),
+        store_us,
+        decode_us,
+        total_us,
+        bytes
+    );
+}
+
+/// RAII guard for the backend in-flight gauge.
+pub struct InFlightGuard(());
+
+impl InFlightGuard {
+    pub fn enter() -> (Self, i64) {
+        let prev = BACKEND_INFLIGHT.fetch_add(1, Ordering::Relaxed);
+        (InFlightGuard(()), prev + 1)
+    }
+}
+
+impl Drop for InFlightGuard {
+    fn drop(&mut self) {
+        BACKEND_INFLIGHT.fetch_sub(1, Ordering::Relaxed);
+    }
+}
diff --git a/lucida-web/src/debug/traceVolumes.ts b/lucida-web/src/debug/traceVolumes.ts
new file mode 100644
index 0000000..6773273
--- /dev/null
+++ b/lucida-web/src/debug/traceVolumes.ts
@@ -0,0 +1,116 @@
+/**
+ * THROWAWAY MEASUREMENT INSTRUMENTATION — issue #888 (research/trace-volumes).
+ *
+ * Counts per-stage pipeline events with 1-second bucketing so a driver can
+ * read totals AND peak per-second rates out of `window.__tv`. Deliberately as
+ * cheap as possible (one object-property increment per event) so the counter
+ * itself is not what we end up measuring.
+ *
+ * NOT product code. Reverted before the research branch is committed; the diff
+ * lives in docs/research/trace-volumes-instrumentation.patch.
+ */
+
+interface TvState {
+  t0: number;
+  totals: Record<string, number>;
+  /** name -> per-second bucket array, index = whole seconds since t0. */
+  buckets: Record<string, number[]>;
+  /** name -> max single observation (e.g. render passes in one frame). */
+  maxes: Record<string, number>;
+  /** name -> every observation, for distribution work (capped). */
+  samples: Record<string, number[]>;
+  marks: Array<{ name: string; at: number }>;
+}
+
+const SAMPLE_CAP = 200000;
+
+function fresh(): TvState {
+  return { t0: performance.now(), totals: {}, buckets: {}, maxes: {}, samples: {}, marks: [] };
+}
+
+declare global {
+  interface Window {
+    __tv?: TvState;
+    __tvReset?: () => void;
+    __tvDump?: () => unknown;
+  }
+}
+
+function st(): TvState | null {
+  if (typeof window === "undefined") return null;
+  if (!window.__tv) {
+    window.__tv = fresh();
+    window.__tvReset = () => {
+      window.__tv = fresh();
+    };
+    window.__tvDump = () => {
+      const s = window.__tv!;
+      const out: Record<string, unknown> = {
+        elapsed_ms: performance.now() - s.t0,
+        totals: s.totals,
+        maxes: s.maxes,
+        marks: s.marks,
+        peak_per_sec: {} as Record<string, number>,
+        buckets: s.buckets,
+        sample_stats: {} as Record<string, unknown>,
+      };
+      const peak = out.peak_per_sec as Record<string, number>;
+      for (const [k, arr] of Object.entries(s.buckets)) {
+        let m = 0;
+        for (const v of arr) if (v > m) m = v;
+        peak[k] = m;
+      }
+      const ss = out.sample_stats as Record<string, unknown>;
+      for (const [k, arr] of Object.entries(s.samples)) {
+        if (!arr.length) continue;
+        const sorted = [...arr].sort((a, b) => a - b);
+        const q = (p: number) => sorted[Math.min(sorted.length - 1, Math.floor(p * sorted.length))];
+        ss[k] = {
+          n: sorted.length,
+          min: sorted[0],
+          p50: q(0.5),
+          p75: q(0.75),
+          p90: q(0.9),
+          p95: q(0.95),
+          p99: q(0.99),
+          max: sorted[sorted.length - 1],
+          sum: sorted.reduce((a, b) => a + b, 0),
+          under_0_1ms: sorted.filter((v) => v < 0.1).length,
+        };
+      }
+      return out;
+    };
+  }
+  return window.__tv;
+}
+
+/** Count `n` occurrences of `name`. */
+export function tvAdd(name: string, n = 1): void {
+  const s = st();
+  if (!s) return;
+  s.totals[name] = (s.totals[name] ?? 0) + n;
+  const sec = Math.floor((performance.now() - s.t0) / 1000);
+  let b = s.buckets[name];
+  if (!b) b = s.buckets[name] = [];
+  while (b.length <= sec) b.push(0);
+  b[sec] += n;
+}
+
+/** Record a single observation `v` of `name` (distribution + max), and count it. */
+export function tvObs(name: string, v: number): void {
+  const s = st();
+  if (!s) return;
+  tvAdd(name + ".sum", v);
+  tvAdd(name + ".n", 1);
+  if (v > (s.maxes[name] ?? -Infinity)) s.maxes[name] = v;
+  let a = s.samples[name];
+  if (!a) a = s.samples[name] = [];
+  if (a.length < SAMPLE_CAP) a.push(v);
+}
+
+/** Timestamped one-off marker (phase boundaries, first frame, …). */
+export function tvMark(name: string): void {
+  const s = st();
+  if (!s) return;
+  s.marks.push({ name, at: performance.now() - s.t0 });
+}
diff --git a/lucida-web/src/debug/tvTelemetryFloor.test.ts b/lucida-web/src/debug/tvTelemetryFloor.test.ts
