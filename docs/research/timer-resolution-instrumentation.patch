diff --git a/lucida-web/src/trStageProbe.ts b/lucida-web/src/trStageProbe.ts
new file mode 100644
index 0000000..e3d22f3
--- /dev/null
+++ b/lucida-web/src/trStageProbe.ts
@@ -0,0 +1,83 @@
+// THROWAWAY instrumentation (issue #897). Not product code.
+//
+// Records the RAW quantised `performance.now()` delta for a few real
+// pipeline stages, so the clock floor can be judged against lucida's own
+// spans rather than a synthetic stand-in. Deliberately stores the delta
+// histogram, not a mean: the clamp is only visible as a set of discrete
+// multiples, and an average launders it away.
+
+interface StageRec {
+  n: number;
+  zeros: number;
+  sum_ms: number;
+  /** delta (ms, as string) -> count. */
+  hist: Record<string, number>;
+  first_ms: number | null;
+  last_ms: number | null;
+}
+
+const stages = new Map<string, StageRec>();
+
+function rec(stage: string): StageRec {
+  let r = stages.get(stage);
+  if (!r) {
+    r = { n: 0, zeros: 0, sum_ms: 0, hist: {}, first_ms: null, last_ms: null };
+    stages.set(stage, r);
+  }
+  return r;
+}
+
+/** Record one span. `t0`/`t1` are raw `performance.now()` readings. */
+export function trSpan(stage: string, t0: number, t1: number): void {
+  const r = rec(stage);
+  const d = t1 - t0;
+  r.n++;
+  if (d === 0) r.zeros++;
+  else {
+    r.sum_ms += d;
+    const k = d.toFixed(6);
+    r.hist[k] = (r.hist[k] || 0) + 1;
+  }
+  if (r.first_ms === null) r.first_ms = t0;
+  r.last_ms = t1;
+}
+
+/** Record a span whose duration was measured elsewhere (e.g. in a worker). */
+export function trDelta(stage: string, d: number): void {
+  const now = performance.now();
+  trSpan(stage, now - d, now);
+}
+
+declare global {
+  interface Window {
+    __trDump?: () => unknown;
+    __trReset?: () => void;
+  }
+}
+
+if (typeof window !== "undefined") {
+  window.__trDump = () => {
+    const out: Record<string, unknown> = {
+      crossOriginIsolated: typeof crossOriginIsolated !== "undefined" ? crossOriginIsolated : null,
+    };
+    for (const [stage, r] of stages) {
+      const entries = Object.entries(r.hist)
+        .map(([k, v]) => [Number(k), v] as [number, number])
+        .sort((a, b) => a[0] - b[0]);
+      out[stage] = {
+        n: r.n,
+        zeros: r.zeros,
+        zero_frac: r.n ? +(r.zeros / r.n).toFixed(4) : null,
+        sum_ms: +r.sum_ms.toFixed(4),
+        min_nonzero_ms: entries.length ? entries[0][0] : null,
+        distinct_nonzero: entries.length,
+        hist: entries.slice(0, 20),
+        // Wall-clock window the stage's events span, so the sum of quantised
+        // spans can be sanity-checked against something the clock measures well.
+        window_ms: r.first_ms !== null && r.last_ms !== null ? +(r.last_ms - r.first_ms).toFixed(3) : null,
+      };
+    }
+    return out;
+  };
+  window.__trReset = () => stages.clear();
+}
