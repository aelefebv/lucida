diff --git a/lucida-web/src/debug/traceVolumes.ts b/lucida-web/src/debug/traceVolumes.ts
new file mode 100644
index 0000000..33340d6
--- /dev/null
+++ b/lucida-web/src/debug/traceVolumes.ts
@@ -0,0 +1,112 @@
+/**
+ * THROWAWAY MEASUREMENT INSTRUMENTATION — issue #888 (research/trace-volumes).
+ *
+ * Counts per-stage pipeline events with 1-second bucketing so a driver can
+ * read totals AND peak per-second rates out of `window.__tv`. Deliberately as
+ * cheap as possible (one object-property increment per event) so the counter
+ * itself is not what we end up measuring.
+ *
+ * NOT product code. Reverted before the research branch is committed; the diff
+ * lives in docs/research/trace-volumes-instrumentation.patch.
+ */
+
+interface TvState {
+  t0: number;
+  totals: Record<string, number>;
+  /** name -> per-second bucket array, index = whole seconds since t0. */
+  buckets: Record<string, number[]>;
+  /** name -> max single observation (e.g. render passes in one frame). */
+  maxes: Record<string, number>;
+  /** name -> every observation, for distribution work (capped). */
+  samples: Record<string, number[]>;
+  marks: Array<{ name: string; at: number }>;
+}
+
+const SAMPLE_CAP = 20000;
+
+function fresh(): TvState {
+  return { t0: performance.now(), totals: {}, buckets: {}, maxes: {}, samples: {}, marks: [] };
+}
+
+declare global {
+  interface Window {
+    __tv?: TvState;
+    __tvReset?: () => void;
+    __tvDump?: () => unknown;
+  }
+}
+
+function st(): TvState | null {
+  if (typeof window === "undefined") return null;
+  if (!window.__tv) {
+    window.__tv = fresh();
+    window.__tvReset = () => {
+      window.__tv = fresh();
+    };
+    window.__tvDump = () => {
+      const s = window.__tv!;
+      const out: Record<string, unknown> = {
+        elapsed_ms: performance.now() - s.t0,
+        totals: s.totals,
+        maxes: s.maxes,
+        marks: s.marks,
+        peak_per_sec: {} as Record<string, number>,
+        buckets: s.buckets,
+        sample_stats: {} as Record<string, unknown>,
+      };
+      const peak = out.peak_per_sec as Record<string, number>;
+      for (const [k, arr] of Object.entries(s.buckets)) {
+        let m = 0;
+        for (const v of arr) if (v > m) m = v;
+        peak[k] = m;
+      }
+      const ss = out.sample_stats as Record<string, unknown>;
+      for (const [k, arr] of Object.entries(s.samples)) {
+        if (!arr.length) continue;
+        const sorted = [...arr].sort((a, b) => a - b);
+        const q = (p: number) => sorted[Math.min(sorted.length - 1, Math.floor(p * sorted.length))];
+        ss[k] = {
+          n: sorted.length,
+          min: sorted[0],
+          p50: q(0.5),
+          p95: q(0.95),
+          max: sorted[sorted.length - 1],
+          sum: sorted.reduce((a, b) => a + b, 0),
+        };
+      }
+      return out;
+    };
+  }
+  return window.__tv;
+}
+
+/** Count `n` occurrences of `name`. */
+export function tvAdd(name: string, n = 1): void {
+  const s = st();
+  if (!s) return;
+  s.totals[name] = (s.totals[name] ?? 0) + n;
+  const sec = Math.floor((performance.now() - s.t0) / 1000);
+  let b = s.buckets[name];
+  if (!b) b = s.buckets[name] = [];
+  while (b.length <= sec) b.push(0);
+  b[sec] += n;
+}
+
+/** Record a single observation `v` of `name` (distribution + max), and count it. */
+export function tvObs(name: string, v: number): void {
+  const s = st();
+  if (!s) return;
+  tvAdd(name + ".sum", v);
+  tvAdd(name + ".n", 1);
+  if (v > (s.maxes[name] ?? -Infinity)) s.maxes[name] = v;
+  let a = s.samples[name];
+  if (!a) a = s.samples[name] = [];
+  if (a.length < SAMPLE_CAP) a.push(v);
+}
+
+/** Timestamped one-off marker (phase boundaries, first frame, …). */
+export function tvMark(name: string): void {
+  const s = st();
+  if (!s) return;
+  s.marks.push({ name, at: performance.now() - s.t0 });
+}
diff --git a/lucida-web/src/debug/tvTelemetryFloor.test.ts b/lucida-web/src/debug/tvTelemetryFloor.test.ts
new file mode 100644
index 0000000..e4d6b71
--- /dev/null
+++ b/lucida-web/src/debug/tvTelemetryFloor.test.ts
@@ -0,0 +1,151 @@
+/**
+ * THROWAWAY MEASUREMENT (issue #888, research/trace-volumes).
+ *
+ * Benchmarks the EXISTING telemetry write+read paths at the event rates
+ * measured live, so the monitor's marginal cost is judged against a real
+ * floor. Not a product test — removed before the research branch commit.
+ *
+ *   npx vitest run src/debug/tvTelemetryFloor.test.ts --reporter=basic
+ */
+import { test } from "vitest";
+import { TelemetryCounters } from "../pipeline/fetch/telemetry.ts";
+import { UploadTelemetry } from "../pipeline/upload/telemetry/upload.ts";
+import { ColdStateTelemetry } from "../pipeline/upload/telemetry/coldState.ts";
+import { emptyUploadTickStats } from "./debugStats.ts";
+
+function bench(name: string, iters: number, fn: (i: number) => void): number {
+  for (let i = 0; i < Math.min(iters, 2000); i++) fn(i); // warm
+  const t0 = performance.now();
+  for (let i = 0; i < iters; i++) fn(i);
+  const dt = performance.now() - t0;
+  const ns = (dt * 1e6) / iters;
+  // eslint-disable-next-line no-console
+  console.log(`FLOOR ${name}: ${iters} iters, ${dt.toFixed(2)}ms total, ${ns.toFixed(1)} ns/op`);
+  return ns;
+}
+
+function retained(label: string, build: () => unknown): void {
+  const g = globalThis as { gc?: () => void };
+  g.gc?.();
+  const before = process.memoryUsage().heapUsed;
+  const held = build();
+  g.gc?.();
+  const after = process.memoryUsage().heapUsed;
+  // eslint-disable-next-line no-console
+  console.log(`RETAINED ${label}: ${(after - before).toLocaleString()} bytes`, held ? "" : "");
+}
+
+test("existing telemetry floor", () => {
+  // --- fetch/telemetry.ts -------------------------------------------------
+  const tc = new TelemetryCounters(0);
+  bench("TelemetryCounters.recordRequest", 2_000_000, () => tc.recordRequest());
+  bench("TelemetryCounters.recordHit", 2_000_000, () => tc.recordHit());
+  bench("TelemetryCounters.recordDecode (100-window push/shift)", 500_000, (i) =>
+    tc.recordDecode(i % 50));
+  bench("TelemetryCounters.recordEviction", 1_000_000, () => tc.recordEviction("active-detail"));
+  bench("TelemetryCounters.snapshot (copy+sort 100)", 200_000, (i) => tc.snapshot(i));
+
+  // --- upload/telemetry/upload.ts ----------------------------------------
+  const ut = new UploadTelemetry();
+  let now = 0;
+  bench("UploadTelemetry.recordEvent", 1_000_000, (i) => ut.recordEvent(i, 65536, false, "chunk"));
+  const stats = emptyUploadTickStats();
+  stats.drainedChunks = 20;
+  stats.uploadedChunks = 8;
+  bench("UploadTelemetry.publish (per deliverToWorker tick)", 100_000, () => {
+    now += 8;
+    ut.publish(now, stats);
+  });
+
+  // publish() cost as a function of live 1s event-ring size
+  for (const perTick of [1, 8, 64, 128]) {
+    const u2 = new UploadTelemetry();
+    let t = 0;
+    bench(`UploadTelemetry.publish with ${perTick} events/tick @120Hz (ring ~${perTick * 120})`,
+      20_000, () => {
+        t += 8.3;
+        for (let k = 0; k < perTick; k++) u2.recordEvent(t, 65536, false, "chunk");
+        u2.publish(t, stats);
+      });
+  }
+
+  // --- upload/telemetry/coldState.ts -------------------------------------
+  const cs = new ColdStateTelemetry();
+  let ct = 0;
+  bench("ColdStateTelemetry.recordHit (walks 1s ring)", 200_000, () => {
+    ct += 8.3;
+    cs.recordHit(ct);
+  });
+  bench("ColdStateTelemetry.recordRebuild", 100_000, () => {
+    ct += 8.3;
+    cs.recordRebuild(ct, ["view"], 3);
+  });
+  bench("ColdStateTelemetry.publish", 500_000, () => cs.publish());
+
+  // --- retained footprint -------------------------------------------------
+  retained("TelemetryCounters x1 (100-sample decode window, saturated)", () => {
+    const t = new TelemetryCounters(0);
+    for (let i = 0; i < 1000; i++) t.recordDecode(i % 40);
+    return t;
+  });
+  retained("UploadTelemetry x1 with a saturated 1s ring at 8 uploads/tick @120Hz (~960 events)", () => {
+    const u = new UploadTelemetry();
+    let t = 0;
+    for (let i = 0; i < 120; i++) {
+      t += 8.3;
+      for (let k = 0; k < 8; k++) u.recordEvent(t, 65536, false, "chunk");
+      u.publish(t, stats);
+    }
+    return u;
+  });
+  retained("UploadTelemetry x1 with a saturated 1s ring at 128 uploads/tick @120Hz (~15k events)", () => {
+    const u = new UploadTelemetry();
+    let t = 0;
+    for (let i = 0; i < 120; i++) {
+      t += 8.3;
+      for (let k = 0; k < 128; k++) u.recordEvent(t, 65536, false, "chunk");
+      u.publish(t, stats);
+    }
+    return u;
+  });
+  retained("ColdStateTelemetry x1 saturated (1s ring @120Hz + 60 durations)", () => {
+    const c = new ColdStateTelemetry();
+    let t = 0;
+    for (let i = 0; i < 240; i++) {
+      t += 8.3;
+      if (i % 2) c.recordHit(t);
+      else c.recordRebuild(t, ["view"], 3);
+    }
+    return c;
+  });
+
+  // --- what a naive per-event trace record would cost ---------------------
+  retained("10,000 plain per-event records {t,stage,key,bytes}", () => {
+    const arr: Array<{ t: number; stage: string; key: string; bytes: number }> = [];
+    for (let i = 0; i < 10_000; i++) {
+      arr.push({ t: i * 0.1, stage: "fetch", key: `0/0/0/${i >> 8}/${(i >> 4) & 15}/${i & 15}`, bytes: 65536 });
+    }
+    return arr;
+  });
+  retained("100,000 plain per-event records {t,stage,key,bytes}", () => {
+    const arr: Array<{ t: number; stage: string; key: string; bytes: number }> = [];
+    for (let i = 0; i < 100_000; i++) {
+      arr.push({ t: i * 0.1, stage: "fetch", key: `0/0/0/${i >> 8}/${(i >> 4) & 15}/${i & 15}`, bytes: 65536 });
+    }
+    return arr;
+  });
+  retained("100,000 columnar records (3 typed arrays + interned stage)", () => {
+    const t = new Float64Array(100_000);
+    const stage = new Uint8Array(100_000);
+    const bytes = new Uint32Array(100_000);
+    for (let i = 0; i < 100_000; i++) { t[i] = i * 0.1; stage[i] = 2; bytes[i] = 65536; }
+    return [t, stage, bytes];
+  });
+
+  bench("push one plain object record onto an array", 2_000_000, (i) => {
+    sink.push({ t: i, stage: 2, key: i, bytes: 65536 });
+    if (sink.length > 100_000) sink.length = 0;
+  });
+});
+
+const sink: Array<{ t: number; stage: number; key: number; bytes: number }> = [];
